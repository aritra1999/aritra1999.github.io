@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
	:root {
		--background: 223 15% 98%;
		--foreground: 222.2 84% 4.9%;

		--muted: 210 40% 96.1%;
		--muted-foreground: 215.4 16.3% 46.9%;

		--popover: 0 0% 100%;
		--popover-foreground: 222.2 84% 4.9%;

		--card: 0 0% 100%;
		--card-foreground: 222.2 84% 4.9%;

		--border: 215 15.8% 14.9%;
		--input: 214.3 31.8% 91.4%;

		--primary: 222.2 47.4% 11.2%;
		--primary-foreground: 210 40% 98%;

		--secondary: 210 40% 96.1%;
		--secondary-foreground: 222.2 47.4% 11.2%;

		--accent: 210 40% 96.1%;
		--accent-foreground: 222.2 47.4% 11.2%;

		--destructive: 0 72.2% 50.6%;
		--destructive-foreground: 210 40% 98%;

		--ring: 222.2 84% 4.9%;

		--radius: 0.5rem;
	}

	.dark {
		color-scheme: dark;

		--background: 222 18% 7%;
		--foreground: 210 40% 98%;

		--muted: 222 14% 15%;
		--muted-foreground: 215 20% 72%;

		--popover: 222 16% 15%;
		--popover-foreground: 210 40% 98%;

		--card: 222 16% 12%;
		--card-foreground: 210 40% 98%;

		--border: 222 14% 24%;
		--input: 222 14% 24%;

		--primary: 210 40% 98%;
		--primary-foreground: 222.2 47.4% 11.2%;

		--secondary: 222 14% 16%;
		--secondary-foreground: 210 40% 98%;

		--accent: 222 16% 18%;
		--accent-foreground: 210 40% 98%;

		--destructive: 0 62.8% 50.6%;
		--destructive-foreground: 210 40% 98%;

		--ring: 217 91% 60%;
	}

	.dark body {
		--grid-color: #2b3240;
		--paper-color: #0f1115;
	}
}

@layer base {
	* {
		@apply border-border;
	}
	body {
		font-family: 'Bricolage Grotesque', sans-serif;

		@apply bg h-screen w-screen overflow-hidden text-foreground;
	}
}

.bg {
	--grid-size: 1rem;
	--grid-strength: 1px;
	--grid-dash: 0px;
	--grid-gap: 10px;
	--grid-color: #dddddd;
	--paper-color: #fff;

	background-color: var(--paper-color);
	background-size:
		var(--grid-dash) var(--grid-dash),
		var(--grid-size) var(--grid-size);
	background-image:
		linear-gradient(to bottom, transparent var(--grid-gap), var(--paper-color) var(--grid-gap)),
		linear-gradient(
			to right,
			var(--grid-color) var(--grid-strength),
			transparent var(--grid-strength)
		),
		linear-gradient(to right, transparent var(--grid-gap), var(--paper-color) var(--grid-gap)),
		linear-gradient(
			to bottom,
			var(--grid-color) var(--grid-strength),
			transparent var(--grid-strength)
		);
}

*:focus {
	outline: none;
}

.tag {
	@apply mb-1 mr-2 inline-block rounded-full border border-transparent bg-blue-100 px-2 pb-0.5 pt-1 text-xs font-medium text-blue-700 dark:border-blue-400/25 dark:bg-blue-500/15 dark:text-blue-200;
}

.card {
	@apply mb-4 inline-block w-full rounded-lg bg-white shadow-sm transition duration-300 ease-in hover:shadow-lg dark:border-border dark:bg-card dark:shadow-[0_8px_30px_rgb(0,0,0,0.45)] dark:hover:border-blue-400/30 dark:hover:shadow-[0_8px_40px_rgb(0,0,0,0.6)];
}

.card-link-container {
	@apply mr-4 mt-4 flex justify-between space-x-8 px-2 pt-4;
}

.card-link {
	@apply flex items-center space-x-1 text-sm font-medium text-blue-600 dark:text-blue-300;
}

::-webkit-scrollbar {
	width: 5px;
	border-radius: 10px;
}

::-webkit-scrollbar-track {
	background: transparent;
	border-radius: 10px;
}

::-webkit-scrollbar-thumb {
	background: #88888899;
	border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
	background: #888888b3;
}

.ishtyle {
	background: repeating-linear-gradient(
		135deg,
		transparent,
		transparent 3px,
		#c6c6c6 6px,
		#c6c6c6 4px
	);
}

.dark .ishtyle {
	background: repeating-linear-gradient(
		135deg,
		transparent,
		transparent 3px,
		#353a46 6px,
		#353a46 4px
	);
}
