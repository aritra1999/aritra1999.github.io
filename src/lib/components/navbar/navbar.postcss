.navbar-container {
	@apply fixed z-[60] flex w-screen items-center justify-between bg-transparent p-4;
}

.profile-picture {
	@apply h-10 w-10 rounded-full object-cover  hover:ring-4 hover:ring-neutral-200;
}

.icon-container {
	@apply rounded-full p-2 hover:bg-neutral-200 dark:hover:bg-accent;
}

.navbar-search-container {
	@apply flex w-full items-center justify-between border bg-white px-3.5 py-2.5 text-sm text-neutral-900 dark:border-border dark:bg-secondary dark:text-neutral-100;
}
